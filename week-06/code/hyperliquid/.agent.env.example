# Copy to .agent.env (gitignored). Used by hl_agent.py, hl_funding.py, hl_carry_bot.py.
# AGENT_PRIVATE_KEY = a trade-only API wallet approved on Hyperliquid (can trade, cannot withdraw).
# MASTER_ADDRESS    = your main account address (orders are booked under it).
AGENT_PRIVATE_KEY=0xYOUR_TRADE_ONLY_API_WALLET_KEY
MASTER_ADDRESS=0xYOUR_MAIN_ACCOUNT_ADDRESS
